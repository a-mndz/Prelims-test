# Environment contract (plan §8, RULES #7). Copy to .env and fill in.
# .env is gitignored. STAGING AND PRODUCTION MUST USE DIFFERENT VALUES for
# JWT_SECRET and DATABASE_URL — never share a secret or a DB across envs.

# --- Required in production (the app refuses to boot without these) ---
# "Production" means NODE_ENV=production or any deployment on Vercel. There are no
# fallback values: a placeholder JWT secret lets anyone forge an admin session, and the
# default seed credentials below are published in this repo.
NODE_ENV=production
JWT_SECRET=            # 32+ random bytes, unique per env. e.g. `openssl rand -hex 32`

# Postgres connection. Set exactly one of these:
#   DATABASE_URL              self-managed/managed Postgres (never SQLite on the app box, plan §8)
#   POSTGRES_URL              injected automatically once the Supabase store is connected to
#                             the Vercel project (Storage -> the Supabase store -> Connect
#                             Project). Pooled, pgbouncer, port 6543.
#   POSTGRES_URL_NON_POOLING  also injected by that integration. Direct, port 5432; used on
#                             its own for the one-time schema bootstrap (DDL over a
#                             transaction-mode pooler is unreliable).
# Precedence is DATABASE_URL > POSTGRES_URL > POSTGRES_URL_NON_POOLING. With none of them
# set, a deployed environment fails with 503 store_not_configured instead of silently
# serving from the in-memory store, whose writes vanish on every cold start.
DATABASE_URL=
# PG_POOL_MAX=2        # per-process pool ceiling; defaults to 2 on Vercel (every warm
                       # instance keeps its own pool) and 10 elsewhere.

# --- Server ---
PORT=3000
# COOKIE_SECURE=false  # dev-only http override; prod always forces Secure
# TRUST_PROXY_HOPS=1   # set to the number of trusted proxies in front of the app (TLS
                       # terminator / load balancer). 0 = none. WITHOUT this, all traffic
                       # behind a proxy shares the proxy's IP and per-IP login limits +
                       # admin lockout collapse onto the whole cohort. Never leave at 0 in
                       # prod if a proxy terminates TLS (plan §8).

# --- Timing (plan §4.1) — mechanism is in code, these are the numbers ---
EXAM_DURATION_SEC=3600
GRACE_SEC=5
LOGIN_START_BUFFER_SEC=1800

# --- Rate limits (plan §2.3) ---
RL_PARTICIPANT_LOGIN=5
RL_ADMIN_LOGIN=3
RL_ANSWER=60
RL_EVENT=30
RL_SUBMIT=5
LOGIN_LOCKOUT=10
# Lockout DECAYS after this many seconds of no new failures (no permanent account DoS).
LOGIN_LOCKOUT_WINDOW_SEC=900

# --- Seed credentials (seed.js) — REQUIRED in production, rotate after the dry run ---
# seed.js runs on every cold start, so these are live credentials, not a dev convenience.
# SEED_ADMIN_USER/PASS are mandatory in production (there would otherwise be no way into
# the admin portal); the demo participant is only seeded when SEED_PARTICIPANT_USER is set,
# because in production participants are created through the admin portal.
SEED_PARTICIPANT_USER=
SEED_PARTICIPANT_PASS=
SEED_ADMIN_USER=
SEED_ADMIN_PASS=
